# Leave these blank to use the bundled sample data and local JSON persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Required for a production admin dashboard. Use long, unique values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
